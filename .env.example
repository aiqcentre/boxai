# ========================================
# BoxAI Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to version control

# ========================================
# AI/LLM Configuration
# ========================================
# Required: OpenAI API key for pydantic-ai agents
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Model selection (default: gpt-5-mini)
# MODEL_NAME=gpt-5-mini

# ========================================
# Database Configuration
# ========================================
# Choose database type: "duckdb" or "postgres"
DB_TYPE=duckdb

# DuckDB Configuration (used when DB_TYPE=duckdb)
DB_PATH=src/data/numero.duckdb
DUCKDB_TABLE=films_raw

# PostgreSQL Configuration (used when DB_TYPE=postgres)
# Uncomment and fill in these values if using PostgreSQL
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# POSTGRES_DB=boxai
# POSTGRES_USER=boxai_user
# POSTGRES_PASSWORD=your-secure-password-here
POSTGRES_TABLE=boxai

# ========================================
# Application Paths (Optional)
# ========================================
# Path to README file (default: README.md)
# Used to dynamically load API endpoints
README_FILE=README.md

# Model artifacts paths
# WEEK1_MODEL_PATH=src/models/artifacts/week1_model.pkl
# FINAL_TOTAL_MODEL_PATH=src/models/artifacts/final_total