# ========================================
# BoxAI Environment Configuration
# ========================================
# Copy this file to .env and fill in your actual values
# Do NOT commit .env to version control

# ========================================
# AI/LLM Configuration
# ========================================
# Required: OpenAI API key for pydantic-ai agents
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Model selection (default: gpt-5-mini)
# MODEL_NAME=gpt-5-mini

# ========================================
# Application Paths (Optional)
# ========================================
# Path to README file (default: README.md)
# Used to dynamically load API endpoints
README_FILE=README.md

# Database path (default: src/data/numero.duckdb)
# DB_PATH=src/data/numero.duckdb

# Model artifacts paths
# WEEK1_MODEL_PATH=src/models/artifacts/week1_model.pkl
# FINAL_TOTAL_MODEL_PATH=src/models/artifacts/final_total